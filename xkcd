#!/usr/bin/env bash
#
# XKCD
#
# Display a XCKD comic on kitty terminalxkcd-command.png
#
# Requires: - Kitty terminal (https://sw.kovidgoyal.net/kitty/) with icat kitten
#           - Core utilities found in unix-like systems: curl, grep, cut, perl.
#
# Usage: Run 'xkcd --help' to find out
#
# Author: Rob O'Leary
# Date: 24/02/22

URL=https://xkcd.com/
img=""
title=""

function parse() {
	temp_file=$(mktemp)
	curl -s -L $URL > "$temp_file"
  
	# get the line containing an img element with a src and a title
  line=$(grep 'img src.* title=".*' "$temp_file")

  # get the value of the src attribute. In the regex, the square brackets bit - [^/]  - will match any character apart from a double quote.
  re="src=\"([^\"]+)"
  if [[ "$line" =~ $re  ]];
  then
   img="https:${BASH_REMATCH[1]}"
  fi

  # get the value of the title attribute
  re="title=\"([^\"]+)"
  if [[ "$line" =~ $re  ]];
  then
    # we need to decode HTML entities e.g &quot; to display text correctly
   title="$(echo ${BASH_REMATCH[1]} | perl -MHTML::Entities -pe 'decode_entities($_);')"
  fi

	rm "${temp_file}"
}

function show(){
	parse
	kitty +kitten icat --align left "$img"
	echo ""
	echo "$title"
}

function show_random(){
	URL=https://c.xkcd.com/random/comic
	show
}

function help() {
		fmt_help="  %-20s\t%-54s\n"

    echo "Description: Display XKCD comic in the terminal."
    echo ""
    echo "Usage: xkcd [-l|--latest] [-r|--random] [-h|--help]"
    printf "$fmt_help" \
        "-h, --help" "Print the help page." \
				"-l, --latest" "Show the latest comic." \
        "-r, --random" "Show a random comic."	
}

case "$#" in
    0)
        help
        ;;
    1)
        case "$1" in
            -h | --help)
                help
                ;;
            -l | --latest)
                show
                ;;
            -r | --random )
								show_random
                ;;
            *)
                echo "Input error."
                exit 1
                ;;
        esac
        ;;
esac
